generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String           @id @default(uuid())
  email           String           @unique
  google_id       String?          @unique
  name            String
  password_hash   String
  xp              Int              @default(0)
  current_streak  Int              @default(0)
  profile_metadata String?
  avatar_url       String?
  role_track       String?
  workspace_name   String?
  focus_target_hours Int           @default(4)
  is_onboarded     Boolean         @default(false)
  created_at       DateTime        @default(now())
  updated_at       DateTime        @updatedAt

  tasks              Task[]
  study_sessions     StudySession[]
  goals              Goal[]
  competitions       Competition[]
  projects           Project[]
  journal_entries    JournalEntry[]
  knowledge_docs     KnowledgeDoc[]
  learning_materials LearningMaterial[]
  daily_rituals      DailyRitual[]

  @@map("users")
}

model Task {
  id             String    @id @default(uuid())
  user_id        String
  title          String
  description    String?
  priority       String    @default("medium") // high, medium, low
  due_date       DateTime?
  estimated_minutes Int      @default(25)
  is_completed   Boolean   @default(false)
  completed_at   DateTime?
  rolled_over    Boolean   @default(false)
  category       String?
  tags           String[]
  xp             Int       @default(15)
  created_at     DateTime  @default(now())
  updated_at     DateTime  @updatedAt

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id, due_date])
  @@index([user_id, is_completed])
  @@map("tasks")
}

model StudySession {
  id               String   @id @default(uuid())
  user_id          String
  title            String?
  start_time       DateTime
  end_time         DateTime
  duration_minutes Int
  session_type     String   @default("sprint") // sprint, deep_work, review
  created_at       DateTime @default(now())

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id, start_time])
  @@map("study_sessions")
}

model Goal {
  id                  String    @id @default(uuid())
  user_id             String
  title               String
  description         String?
  deadline            DateTime?
  target_date         DateTime?
  status              String    @default("active") // active, completed, paused
  progress_percentage Int       @default(0)
  milestones          Json?     @default("[]")
  category            String?
  created_at          DateTime  @default(now())
  updated_at          DateTime  @updatedAt

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id, status])
  @@map("goals")
}

model Competition {
  id          String    @id @default(uuid())
  user_id     String
  title       String
  description String?
  organizer   String?
  type        String?
  deadline    DateTime?
  status      String    @default("preparation") // preparation, active, completed
  timeline    Json?
  outcome     String?
  links       Json?
  documentation_images Json?
  created_at  DateTime  @default(now())
  updated_at  DateTime  @updatedAt

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id, status])
  @@map("competitions")
}

model Project {
  id               String    @id @default(uuid())
  user_id          String
  title            String
  description      String?
  deadline         DateTime?
  status           String    @default("Planning") // Planning, Development, Completed, Archived
  priority         String    @default("MEDIUM")   // HIGH, MEDIUM, LOW
  progress_percent Int       @default(0)
  logo_url         String?
  category         String    @default("Engineering")
  prd_url          String?
  design_url       String?
  repo_url         String?
  demo_url         String?
  created_at       DateTime  @default(now())
  updated_at       DateTime  @updatedAt

  user  User          @relation(fields: [user_id], references: [id], onDelete: Cascade)
  tasks ProjectTask[]

  @@index([user_id, status])
  @@map("projects")
}

model ProjectTask {
  id         String   @id @default(uuid())
  project_id String
  title      String
  status     String   @default("todo") // todo, doing, done
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  project Project @relation(fields: [project_id], references: [id], onDelete: Cascade)

  @@index([project_id, status])
  @@map("project_tasks")
}

model JournalEntry {
  id          String   @id @default(uuid())
  user_id     String
  title       String?
  entry_date  DateTime
  content     String
  emotion_tag String?
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id, entry_date])
  @@map("journal_entries")
}

model KnowledgeDoc {
  id         String   @id @default(uuid())
  user_id    String
  title      String
  content    String   @default("")
  category   String?
  is_pinned  Boolean  @default(false)
  tags       String[]
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id, category])
  @@map("knowledge_docs")
}

model LearningMaterial {
  id         String   @id @default(uuid())
  user_id    String
  title      String
  type       String?  // course, paper, video, book
  url        String?
  status     String   @default("not_started") // not_started, in_progress, completed
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id, status])
  @@map("learning_materials")
}

model DailyRitual {
  id                  String    @id @default(uuid())
  user_id             String
  title               String
  target_minutes      Int       @default(30)
  is_active           Boolean   @default(true)
  created_at          DateTime  @default(now())
  updated_at          DateTime  @updatedAt

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)
  logs DailyRitualLog[]

  @@index([user_id])
  @@map("daily_rituals")
}

model DailyRitualLog {
  id             String      @id @default(uuid())
  ritual_id      String
  user_id        String
  completed_date DateTime    @db.Date
  created_at     DateTime    @default(now())

  ritual DailyRitual @relation(fields: [ritual_id], references: [id], onDelete: Cascade)

  @@unique([ritual_id, completed_date], name: "unique_ritual_per_day")
  @@index([user_id, completed_date])
  @@map("daily_ritual_logs")
}