generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String           @id @default(uuid())
  email           String           @unique
  name            String
  xp              Int              @default(0)
  current_streak  Int              @default(0)
  profile_metadata String?
  created_at      DateTime         @default(now())
  updated_at      DateTime         @updatedAt

  tasks              Task[]
  study_sessions     StudySession[]
  goals              Goal[]
  competitions       Competition[]
  projects           Project[]
  journal_entries    JournalEntry[]
  knowledge_docs     KnowledgeDoc[]
  learning_materials LearningMaterial[]

  @@map("users")
}

model Task {
  id             String    @id @default(uuid())
  user_id        String
  title          String
  description    String?
  priority       String    @default("medium") // high, medium, low
  scheduled_date DateTime?
  is_completed   Boolean   @default(false)
  category       String?
  tags           String[]
  xp             Int       @default(10)
  created_at     DateTime  @default(now())
  updated_at     DateTime  @updatedAt

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id, scheduled_date])
  @@index([user_id, is_completed])
  @@map("tasks")
}

model StudySession {
  id               String   @id @default(uuid())
  user_id          String
  title            String?
  start_time       DateTime
  end_time         DateTime
  duration_minutes Int
  session_type     String   @default("sprint") // sprint, deep_work, review
  created_at       DateTime @default(now())

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id, start_time])
  @@map("study_sessions")
}

model Goal {
  id                  String    @id @default(uuid())
  user_id             String
  title               String
  description         String?
  deadline            DateTime?
  status              String    @default("active") // active, completed, paused
  progress_percentage Int       @default(0)
  category            String?
  created_at          DateTime  @default(now())
  updated_at          DateTime  @updatedAt

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id, status])
  @@map("goals")
}

model Competition {
  id          String    @id @default(uuid())
  user_id     String
  title       String
  description String?
  organizer   String?
  type        String?
  deadline    DateTime?
  status      String    @default("preparation") // preparation, active, completed
  created_at  DateTime  @default(now())
  updated_at  DateTime  @updatedAt

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id, status])
  @@map("competitions")
}

model Project {
  id          String    @id @default(uuid())
  user_id     String
  title       String
  description String?
  deadline    DateTime?
  status      String    @default("active") // active, completed, archived
  progress    Int       @default(0)
  created_at  DateTime  @default(now())
  updated_at  DateTime  @updatedAt

  user  User          @relation(fields: [user_id], references: [id], onDelete: Cascade)
  tasks ProjectTask[]

  @@index([user_id, status])
  @@map("projects")
}

model ProjectTask {
  id         String   @id @default(uuid())
  project_id String
  title      String
  status     String   @default("todo") // todo, doing, done
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  project Project @relation(fields: [project_id], references: [id], onDelete: Cascade)

  @@index([project_id, status])
  @@map("project_tasks")
}

model JournalEntry {
  id          String   @id @default(uuid())
  user_id     String
  title       String?
  entry_date  DateTime
  content     String
  emotion_tag String?
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id, entry_date])
  @@map("journal_entries")
}

model KnowledgeDoc {
  id         String   @id @default(uuid())
  user_id    String
  title      String
  content    String   @default("")
  category   String?
  is_pinned  Boolean  @default(false)
  tags       String[]
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id, category])
  @@map("knowledge_docs")
}

model LearningMaterial {
  id         String   @id @default(uuid())
  user_id    String
  title      String
  type       String?  // course, paper, video, book
  url        String?
  status     String   @default("not_started") // not_started, in_progress, completed
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id, status])
  @@map("learning_materials")
}
